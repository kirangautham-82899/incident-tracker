# Environment Configuration Example
# Copy this to .env and update with your values

NODE_ENV=development
PORT=5000

# MongoDB Connection
# Option 1: Local MongoDB (if you have MongoDB installed locally)
# MONGODB_URI=mongodb://localhost:27017/incident-tracker

# Option 2: MongoDB Atlas (Recommended - completely FREE!)
# Steps to get MongoDB Atlas connection string:
# 1. Go to https://cloud.mongodb.com
# 2. Create FREE account
# 3. Create FREE cluster (M0 tier - 512MB free)
# 4. Create database user
# 5. Get connection string, replace <password> and <dbname>
# Format: mongodb+srv://username:password@cluster.mongodb.net/incident-tracker

MONGODB_URI=mongodb+srv://incident_user:Keerthana123@cluster0.60cpjrl.mongodb.net/?appName=Cluster0

# JWT Secret (IMPORTANT: Change this to a random string in production!)
JWT_SECRET=super-secret-jwt-key-please-change-this-in-production

# Cloudinary (Optional - for image/video uploads)
# Get from https://cloudinary.com (Free tier: 25GB storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key  
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
